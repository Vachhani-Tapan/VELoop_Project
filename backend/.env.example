# ─── Backend Environment ─────────────────────────────────────────────────────
# Copy this file to .env (never commit .env)

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/veloop?retryWrites=true&w=majority

# JWT secret — use a long random string (e.g. openssl rand -hex 64)
JWT_SECRET=your_jwt_secret_here

# JWT expiry (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# Port the Express server listens on
PORT=3000

# Node environment: development | production | test
NODE_ENV=development

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173
